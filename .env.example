## Copy this to .env and fill real values. Do NOT commit secrets.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SWU credentials
SWU_USER=your_swu_username
SWU_PASSWORD=your_swu_password

# Optional override endpoints
SWU_LOGIN_URL=
SWU_CHAT_URL=

# Token storage
TOKEN_FILE=token.json
TOKEN_EXPIRE_MS=3600000

# CORS
CORS_ORIGIN=https://your-frontend.example.com

# Rate limit
RATE_LIMIT_MAX=60

# Default model
DEFAULT_MODEL=google/gemini-2.5-flash

# n8n minimal auth (required to secure UI). Either set these or export envs before running.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
